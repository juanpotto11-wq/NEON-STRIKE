[application]
config/name="NEON STRIKE V3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.01,0.015,0.04,1)

[input]
move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
fire={"deadzone":0.3,"events":[Object(InputEventMouseButton,"button_index":1)]}
reload={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":82)]}
weapon_next={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":81)]}
pause_game={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[physics]
common/physics_ticks_per_second=60

[gui]
theme/default_font_multichannel_signed_distance_field=true

[android]
orientation=1
